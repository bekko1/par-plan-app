# --- Supabase ---
# Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。RLSをバイパスするのでAPI Route/サーバーコンポーネント以外では絶対に使わない
SUPABASE_SERVICE_ROLE_KEY=

# --- 楽天ウェブサービス / GORA API ---
# 本番は「Webアプリケーション」タイプで登録したapplicationId(許可Webサイト+Origin/Referer検証方式)
RAKUTEN_APPLICATION_ID=
# 2026年5月のAPI基盤刷新で必須化されたaccessKey(HTTPヘッダーで送信)
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトのaffiliateId。詳細ページ/予約URLをhb.afl.rakuten.co.jp経由リンクに変換する際に使用
RAKUTEN_AFFILIATE_ID=

# --- Google Maps API ---
# Distance Matrix等、必要になった時点で使用(Haversine概算がメイン)
GOOGLE_MAPS_API_KEY=
